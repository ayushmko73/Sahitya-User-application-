# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The Supabase Project URL
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# SUPABASE_ANON_KEY: The Supabase Anonymous API Key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# CHAT_API KEYS: Dynamic allocation for active chats based on least used allocation
CHAT_API_1=YOUR_CHAT_API_1
CHAT_API_2=YOUR_CHAT_API_2
CHAT_API_3=YOUR_CHAT_API_3
CHAT_API_4=YOUR_CHAT_API_4
CHAT_API_5=YOUR_CHAT_API_5
CHAT_API_6=YOUR_CHAT_API_6
CHAT_API_7=YOUR_CHAT_API_7
CHAT_API_8=YOUR_CHAT_API_8
CHAT_API_9=YOUR_CHAT_API_9
CHAT_API_10=YOUR_CHAT_API_10

